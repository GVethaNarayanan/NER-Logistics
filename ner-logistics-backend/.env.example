# ── Database ──────────────────────────────────────────────────────────────────
# For local quick-start, leave DATABASE_URL unset and the app will use SQLite.
# For deployment, point this at your Postgres instance:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ner_logistics

# ── Open-Meteo (free weather API — no key required) ──────────────────────────
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Use "*" for development only.
# Example for production: CORS_ORIGINS=https://ner-logistics.example.com
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── JWT Authentication ────────────────────────────────────────────────────────
# CRITICAL: Change JWT_SECRET_KEY in production!
# JWT_SECRET_KEY=your-production-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# ── Seed Admin (development only) ────────────────────────────────────────────
# Override these in production.  Do NOT use default credentials in deployment.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin_dev_password
SEED_ADMIN_EMAIL=admin@ner-logistics.dev

# ── Vehicle Simulation ────────────────────────────────────────────────────────
# Toggle the background vehicle movement simulator (true by default).
# Set to false in production if using real GPS data.
VEHICLE_SIMULATION_ENABLED=true
